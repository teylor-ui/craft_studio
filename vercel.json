{
  "version": 2,
  "name": "novacraft-studio",
  "regions": ["iad1"],
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api/subscribe", "destination": "/api/subscribe" },
    { "source": "/api/status", "destination": "/api/status" },
    { "source": "/((?!css|js|robots\\.txt|sitemap\\.xml|favicon).*)", "destination": "/api/gateway" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/status",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
